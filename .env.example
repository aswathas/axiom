# ─────────────────────────────────────────────────────────────
#  LLM CREDENTIALS — template file. Copy to .env and fill in.
#
#      cp .env.example .env
#
#  .env is gitignored. Never commit a real key. Never paste a
#  key into chat, source code, or any transcript.
# ─────────────────────────────────────────────────────────────

# Primary: OpenRouter (free tier)
OPENROUTER_API_KEY=
# NOTE: the ":free" suffix is required. Without it OpenRouter returns 404.
OPENROUTER_MODEL=apodex/apodex-1.1-mini:free

# ─────────────────────────────────────────────────────────────
#  Alternate provider — set EITHER one, not both.
#  MiniMax is OpenAI-compatible, so no code changes are needed.
# ─────────────────────────────────────────────────────────────
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3.1-Flash-Preview